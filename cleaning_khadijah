"""Clean tracts_merged.parquet -> data/processed/tracts_clean.parquet"""
import numpy as np
import pandas as pd

df = pd.read_parquet("data/processed/tracts_merged.parquet")
print("Raw shape:", df.shape)

assert (df["places_pop"] == df["Pop2010"]).all()
df = df.drop(columns=["places_pop"])

# 2. Keep GEOID as a zero-padded string and add a state FIPS column
df["GEOID"] = df["GEOID"].astype(str).str.zfill(11)
df["state_fips"] = df["GEOID"].str[:2]
assert df["GEOID"].is_unique

# 3. Drop rows missing the outcome (all are Florida, state 12, absent from PLACES)
df = df.dropna(subset=["depression", "mental_distress"])

# 4. Put every rate/share on the same 0-1 scale (USDA columns are 0-100)
pct_cols = ["PovertyRate", "lapop1share", "lapop10share",
            "lahunv1share", "lahunv10share"]
df[pct_cols] = df[pct_cols] / 100

# 6. Flag tiny tracts whose rates are unstable (e.g. 100% unemployment)
df["small_tract"] = (df["Pop2010"] < 500) | (df["OHU2010"] < 50)


# 8. Report what's still missing; decide per column whether to drop or impute
print("Remaining missing values:")
print(df.isna().sum()[lambda s: s > 0])
print("Clean shape:", df.shape)


no_poverty_rate = df[df["acs_poverty_rate"].isna()]
#print(no_poverty_rate["Pop2010"])


df = df.rename(columns={"Pop2010": "population", "Urban" : "urban_yes", "MedianFamilyIncome": "median_family_income"})

before_poverty_drop = len(df)
df = df.dropna(subset=["acs_poverty_rate"])
print(f"Dropped {before_poverty_drop - len(df)} rows that did not have a poverty rate due to low population")

print(df.columns)


df.to_parquet("data/processed/tracts_clean.parquet", index=False)
